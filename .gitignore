# Local .terraform and build directories
**/.terraform/*
.build/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log
__pycache__/

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files
.terraform.tfstate.lock.info

# Local AWS credentials
aws-env.sh
